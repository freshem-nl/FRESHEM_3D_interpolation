# UNC example (single quotes or forward slashes):
# nc_file: '//tsn.tno.nl/RA-Data/.../prediction.nc'
paths:
  nc_file: C:/path/to/output/data/LCI_Sharp_MOD_inv - geostat - rho.nc
  dst_dir: C:/path/to/output/idf

vertical_dim: z
dim_mapping: {}

export:
  mode: bulk
  filename_template: "idx_{idx:03d}_{var}_NAP_{z}.idf"
  z_format: ".2f"
  z_offset: -0.25

variables:
  - "P(rho≤1)"
  - "P(rho≤5)"
